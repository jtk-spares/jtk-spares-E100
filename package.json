{
  "name": "jtk",
  "version": "1.0.0",
  "description": "A modern full-stack web application with separate frontend and backend.",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:start": "node backend/src/index.js",
    "backend:dev": "nodemon backend/src/index.js",
    "backend:test": "jest",
    "frontend:start": "vite",
    "frontend:build": "vite build",
    "frontend:test": "echo \"No frontend test suite configured yet\"",
    "frontend:dev": "vite",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@21st-sdk/agent": "^0.0.16",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.11.0",
    "multer": "^2.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.74.0",
    "react-router-dom": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "jest": "^29.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.10",
    "prisma": "^6.19.3",
    "react-scripts": "^0.0.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.9"
  }
}
