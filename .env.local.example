# Copy this file to .env.local and fill in your Afrihost cPanel MySQL credentials.
# NEVER commit .env.local to version control.

# MySQL connection (Afrihost cPanel)
DB_HOST=your-cpanel-mysql-host.afrihost.com
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# Set to "true" if your host requires SSL (check with Afrihost support)
DB_SSL=false

# Restrict CORS to your production domain
ALLOWED_ORIGIN=https://your-domain.vercel.app
